# --------------------------------------------------------------------
# Argus environment configuration
# Copy to .env and fill in. Anything marked REQUIRED must be set
# before `docker compose up`.
# --------------------------------------------------------------------

# ----- Core ---------------------------------------------------------
NODE_ENV=development
ARGUS_LOG_LEVEL=info                # debug | info | warn | error
ARGUS_INGEST_TOKEN=change-me        # REQUIRED: bearer token for POST /v1/events

# ----- Postgres -----------------------------------------------------
# Host port 5435 (not 5432) so an existing local Postgres doesn't clash.
# DATABASE_URL inside containers always uses 5432 (the container-internal port).
POSTGRES_HOST=postgres
POSTGRES_PORT=5435
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus             # REQUIRED in any non-local deployment
DATABASE_URL=postgres://argus:argus@postgres:5432/argus

# ----- Redis (BullMQ) -----------------------------------------------
# Host port 6381 (not 6379) so an existing local Redis doesn't clash.
REDIS_HOST=redis
REDIS_PORT=6381
REDIS_URL=redis://redis:6379

# ----- API ----------------------------------------------------------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# ----- Dashboard ----------------------------------------------------
# Host port 3033 (not 3000) so other Next dev servers don't clash.
DASHBOARD_PORT=3033
DASHBOARD_PUBLIC_URL=http://localhost:3033
NEXT_PUBLIC_API_URL=http://localhost:4000

# ----- Secrets at rest ----------------------------------------------
# APP_SECRET is a base64-encoded 32-byte key used by AES-GCM to encrypt
# provider API keys + connector credentials at rest. If unset, Argus
# auto-bootstraps one at ~/.argus/secret (mode 0o600) and prints a
# warning. Set this in any non-local install so the key doesn't live
# on the container's disk. Generate one with:
#   openssl rand -base64 32
APP_SECRET=

# ----- AI providers -------------------------------------------------
# Set the global default. Per-investigator overrides are allowed.
ARGUS_DEFAULT_AI_PROVIDER=claude    # claude | openai | gemini | ollama | deepseek

# At least ONE of these is REQUIRED.
ARGUS_CLAUDE_API_KEY=
ARGUS_CLAUDE_MODEL=claude-opus-4-7

ARGUS_OPENAI_API_KEY=
ARGUS_OPENAI_MODEL=gpt-4.1

# Optional providers (scaffolded in v0.1, fully wired in v0.2)
ARGUS_GEMINI_API_KEY=
ARGUS_GEMINI_MODEL=gemini-2.5-pro

ARGUS_OLLAMA_BASE_URL=http://host.docker.internal:11434
ARGUS_OLLAMA_MODEL=llama3.1

ARGUS_DEEPSEEK_API_KEY=
ARGUS_DEEPSEEK_MODEL=deepseek-chat

# ----- Alert channels -----------------------------------------------
# Slack incoming-webhook URL. Used by the default 'slack:ops' channel.
ARGUS_SLACK_WEBHOOK_URL=

# v0.2+: discord, smtp, generic webhook configs land here.

# ----- Telemetry (opt-in) -------------------------------------------
# Set to "true" to send anonymous install pings. Default is off.
ARGUS_TELEMETRY=false
