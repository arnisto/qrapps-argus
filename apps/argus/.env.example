# Argus v1 — names only. Values live in .env.local (gitignored) and in Vercel.

# Supabase project (Auth + Postgres). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the job runner (bypasses RLS). Never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM key for Meta tokens at rest: `openssl rand -base64 32`. Required; the app refuses to start without it.
APP_SECRET=

# Meta developer app (Facebook Login + Marketing API products).
META_APP_ID=
META_APP_SECRET=
# Must match a Valid OAuth Redirect URI in the Meta app, e.g. http://localhost:3050/api/meta/callback
META_REDIRECT_URI=

# Gemini (Google AI Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared secret for POST /api/jobs/run (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Set to 1 once Meta approves Page Public Content Access for the app; competitor pages are then collected.
META_PUBLIC_CONTENT_ACCESS=0
