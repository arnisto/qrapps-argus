{
  "name": "argus",
  "version": "1.0.0-dev",
  "private": true,
  "description": "Argus — a small AI SaaS that watches a company's market and reports with evidence. First client: Lovixa.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @argus/app dev",
    "build": "pnpm --filter @argus/app build",
    "typecheck": "pnpm --filter @argus/app typecheck",
    "lint": "pnpm --filter @argus/app lint",
    "test": "pnpm --filter @argus/app test",
    "format": "prettier --write \"apps/argus/**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"apps/argus/**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.5.0"
  }
}
