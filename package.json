{
  "name": "argus",
  "version": "0.1.0-dev",
  "private": true,
  "description": "AI-native operational observability and investigation platform.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @argus/api db:migrate",
    "db:seed": "pnpm --filter @argus/api db:seed",
    "db:reset": "pnpm --filter @argus/api db:reset",
    "investigator:test": "pnpm --filter @argus/investigators test:investigator",
    "queues:inspect": "pnpm --filter @argus/workers queues:inspect",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
